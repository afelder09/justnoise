# Test environment defaults — committed because it contains no real secrets.
#
# For E2E tests: run `npm run db:start` first. That command starts the local
# Supabase Docker stack and writes the actual credentials to .env.test.local
# (gitignored). The e2e scripts load .env.test.local automatically.
#
# For unit tests (Vitest): these values are used directly. Supabase and Spotify
# are fully mocked via vi.mock / msw, so the keys never make real network calls.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-loaded-from-env-test-local-for-e2e
SUPABASE_SERVICE_ROLE_KEY=placeholder-loaded-from-env-test-local-for-e2e

# Spotify — intercepted by msw in all tests; values just need to be non-empty
SPOTIFY_CLIENT_ID=test_placeholder
SPOTIFY_CLIENT_SECRET=test_placeholder

NEXT_PUBLIC_APP_URL=http://localhost:3000
